import time
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation

# ==============================================================================
# 1. FIXED SYSTEM & PHYSICS PARAMETERS
# ==============================================================================
L = 10.0                  # Box side length
T_DEFAULT = 1000          # Default number of timesteps for single/animation runs

# Baseline Harmonic Spring Parameters
k_DEFAULT = 1.0           # Default spring stiffness constant (k)
rc = 2.0                  # Neighbour interaction cutoff distance (rc)
r0 = 1.2                  # Equilibrium resting spring length (r0)
dt_BASELINE = 0.01        # Default timestep for Baseline spring simulator
vel_max_BASELINE = 5.0    # Default maximum initial velocity component for Baseline

# Stable Lennard-Jones Potential (LJP) Parameters (Tuned to prevent explosion)
epsilon_DEFAULT = 1.0     # Depth of the LJP potential well (epsilon)
sigma_DEFAULT = 0.8       # Collision diameter (sigma); rc = 2.0 = 2.5 * sigma
dt_LJP = 0.001            # Smaller timestep required to resolve r^-12 repulsion
vel_max_LJP = 2.5         # Moderate max velocity so KE is comparable to epsilon

# Steady-state detection criteria (for Dissipation Study)
steady_window = 100       # Number of steps in sliding window
steady_threshold = 1e-3   # Relative energy variation threshold for steady state

# Fixed random seed for reproducibility across comparative studies
SEED = 42


# ==============================================================================
# 2. SAFE PARTICLE INITIALIZATION
# ==============================================================================
def initialize_particles(N, L, vel_max, model="baseline", sigma=sigma_DEFAULT, r0_val=r0, seed=SEED):
    """
    Initializes particle masses, positions, and velocities.
    Uses rejection sampling for positions so particles do not start overlapping
    (which prevents immediate r^-12 numerical explosions in LJP) or stuck on walls.
    """
    rng = np.random.default_rng(seed)
    mass = np.ones(N)

    # Keep particles inside valid wall boundaries
    margin = (sigma / 2.0) if model == "ljp" else 0.05 * L
    # Minimum safe initial distance between any two particles
    min_dist = max(1.12 * sigma, 0.4) if model == "ljp" else 0.3

    # Automatically reduce min_dist slightly if user enters a very large N
    max_packing_dist = 0.65 * (L - 2 * margin) / np.sqrt(max(N, 1))
    min_dist = min(min_dist, max_packing_dist)

    pos = np.zeros((N, 2))
    for i in range(N):
        placed = False
        for _ in range(5000):
            candidate = rng.uniform(margin, L - margin, size=2)
            if i == 0:
                pos[i] = candidate
                placed = True
                break
            dists = np.linalg.norm(pos[:i] - candidate, axis=1)
            if np.all(dists >= min_dist):
                pos[i] = candidate
                placed = True
                break
        if not placed:
            # Fallback if box is extremely crowded for very large N
            pos[i] = rng.uniform(margin, L - margin, size=2)

    vel = rng.uniform(-vel_max, vel_max, size=(N, 2))
    return mass, pos, vel


# ==============================================================================
# 3. CORE PHYSICS FUNCTIONS (Vectorized, Unchanged Physics Formulation)
# ==============================================================================
def pairwise_distances(pos, rc_val=rc):
    """
    Computes pairwise displacement vectors, scalar distances, and boolean
    neighbour mask using vectorized NumPy broadcasting.
    """
    # NxNx2 array of pairwise displacement vectors: r_i - r_j
    d = pos[:, None, :] - pos[None, :, :]

    # NxN array of scalar Euclidean distances
    dist = np.sqrt(d[:, :, 0]**2 + d[:, :, 1]**2)

    # Boolean mask: True if particles are within cutoff rc and not self-interacting
    neighbours = (dist > 0.0) & (dist <= rc_val)

    return d, dist, neighbours


def pair_forces(pos, k_val=k_DEFAULT, r0_val=r0, rc_val=rc):
    """
    Calculates conservative harmonic spring forces on each particle from its
    neighbours: F = -k * (r - r0) * r_hat.
    """
    d, dist, neighbours = pairwise_distances(pos, rc_val)

    # Unit vectors (1e-12 prevents division by zero on the diagonal)
    unit = d / (dist[:, :, None] + 1e-12)

    # Spring force magnitude
    f_mag = -k_val * (dist - r0_val) * neighbours

    # Sum vector contributions from all neighbours
    forces = np.sum(f_mag[:, :, None] * unit, axis=1)
    return forces


def pair_forces_ljp(pos, eps=epsilon_DEFAULT, sig=sigma_DEFAULT, rc_val=rc):
    """
    Calculates conservative Lennard-Jones forces on each particle:
    V(r) = 4 * eps * [(sig / r)^12 - (sig / r)^6]
    F(r) = (24 * eps / r) * [2 * (sig / r)^12 - (sig / r)^6]
    """
    d, dist, neighbours = pairwise_distances(pos, rc_val)

    # Clamp minimum distance strictly in denominator to prevent floating-point
    # overflow during extreme large-dt stress tests while preserving physics
    safe_dist = np.maximum(dist, 1e-4)
    unit = d / (dist[:, :, None] + 1e-12)

    sr6 = (sig / safe_dist) ** 6
    sr12 = sr6 ** 2

    # LJP force magnitude
    f_mag = (24.0 * eps / safe_dist) * (2.0 * sr12 - sr6) * neighbours

    # Sum vector contributions from all neighbours
    F_ljp = np.sum(f_mag[:, :, None] * unit, axis=1)
    return F_ljp


def internal_forces(pos, model="baseline", k_val=k_DEFAULT, r0_val=r0,
                    rc_val=rc, eps=epsilon_DEFAULT, sig=sigma_DEFAULT):
    """Dispatches conservative pairwise internal forces based on chosen model."""
    if model == "ljp":
        return pair_forces_ljp(pos, eps=eps, sig=sig, rc_val=rc_val)
    return pair_forces(pos, k_val=k_val, r0_val=r0_val, rc_val=rc_val)


def total_forces(pos, vel, gamma=0.0, model="baseline", k_val=k_DEFAULT,
                 r0_val=r0, rc_val=rc, eps=epsilon_DEFAULT, sig=sigma_DEFAULT):
    """Sums conservative pairwise forces and non-conservative viscous drag (-gamma * v)."""
    f_cons = internal_forces(pos, model=model, k_val=k_val, r0_val=r0_val,
                             rc_val=rc_val, eps=eps, sig=sig)
    f_drag = -gamma * vel
    return f_cons + f_drag


def walls_reflect(pos, vel, L_val=L, margin=0.0):
    """
    Applies hard-wall reflective boundary conditions.
    For Baseline: margin = 0.0 (walls at 0 and L).
    For LJP:      margin = sigma / 2 (walls at sigma/2 and L - sigma/2).
    """
    min_bound = margin
    max_bound = L_val - margin

    # X-axis walls
    left = pos[:, 0] < min_bound
    right = pos[:, 0] > max_bound
    vel[left, 0] = np.abs(vel[left, 0])     # Point velocity strictly inward
    vel[right, 0] = -np.abs(vel[right, 0])  # Point velocity strictly inward
    pos[left, 0] = min_bound
    pos[right, 0] = max_bound

    # Y-axis walls
    bottom = pos[:, 1] < min_bound
    top = pos[:, 1] > max_bound
    vel[bottom, 1] = np.abs(vel[bottom, 1])
    vel[top, 1] = -np.abs(vel[top, 1])
    pos[bottom, 1] = min_bound
    pos[top, 1] = max_bound

    return pos, vel


# ==============================================================================
# 4. TIME INTEGRATION METHODS
# ==============================================================================
def step_smooth(pos, vel, mass, dt, L_val, gamma, F_prev, model="baseline",
                k_val=k_DEFAULT, r0_val=r0, rc_val=rc,
                eps=epsilon_DEFAULT, sig=sigma_DEFAULT):
    """
    Advances the simulation by one timestep dt using the Velocity Verlet
    (smooth half-step velocity) update.
    """
    margin = (sig / 2.0) if model == "ljp" else 0.0

    if F_prev is None:
        F_prev = total_forces(pos, vel, gamma=gamma, model=model,
                              k_val=k_val, r0_val=r0_val, rc_val=rc_val,
                              eps=eps, sig=sig)

    a_prev = F_prev / mass[:, None]

    # Half-step velocity and full-step position update
    vel_half = vel + 0.5 * a_prev * dt
    pos_new = pos + vel_half * dt

    # Reflect at walls once during position update
    pos_new, vel_half = walls_reflect(pos_new, vel_half, L_val=L_val, margin=margin)

    # Calculate new forces at the updated positions
    F_new = total_forces(pos_new, vel_half, gamma=gamma, model=model,
                         k_val=k_val, r0_val=r0_val, rc_val=rc_val,
                         eps=eps, sig=sig)
    a_new = F_new / mass[:, None]

    # Complete velocity update
    vel_new = vel_half + 0.5 * a_new * dt

    return pos_new, vel_new, F_new


def step_once(pos, vel, mass, dt, L_val, gamma=0.0, model="baseline",
              k_val=k_DEFAULT, r0_val=r0, rc_val=rc,
              eps=epsilon_DEFAULT, sig=sigma_DEFAULT):
    """
    Advances the simulation by one timestep dt using standard first-order
    Euler-Cromer (full-step) integration (used for Integrator Comparison).
    """
    margin = (sig / 2.0) if model == "ljp" else 0.0
    F = total_forces(pos, vel, gamma=gamma, model=model,
                     k_val=k_val, r0_val=r0_val, rc_val=rc_val,
                     eps=eps, sig=sig)
    acc = F / mass[:, None]
    vel_new = vel + acc * dt
    pos_new = pos + vel_new * dt
    pos_new, vel_new = walls_reflect(pos_new, vel_new, L_val=L_val, margin=margin)
    return pos_new, vel_new


# ==============================================================================
# 5. ENERGY, ERROR & DIAGNOSTIC FUNCTIONS
# ==============================================================================
def kinetic_energy(vel, mass):
    """Calculates total kinetic energy K = 0.5 * sum(m_i * v_i^2)."""
    return 0.5 * np.sum(mass[:, None] * (vel ** 2))


def potential_energy(pos, k_val=k_DEFAULT, r0_val=r0, rc_val=rc):
    """Calculates total pairwise harmonic spring potential energy."""
    _, dist, neighbours = pairwise_distances(pos, rc_val)
    U_pairs = 0.5 * k_val * ((dist - r0_val) ** 2) * neighbours
    # Factor 0.5 corrects for double-counting in symmetric distance matrix
    return 0.5 * np.sum(U_pairs)


def potential_energy_ljp(pos, eps=epsilon_DEFAULT, sig=sigma_DEFAULT, rc_val=rc):
    """Calculates total pairwise Lennard-Jones potential energy."""
    _, dist, neighbours = pairwise_distances(pos, rc_val)
    safe_dist = np.maximum(dist, 1e-4)
    sr6 = (sig / safe_dist) ** 6
    sr12 = sr6 ** 2
    U_pairs = 4.0 * eps * (sr12 - sr6) * neighbours
    return 0.5 * np.sum(U_pairs)


def compute_potential(pos, model="baseline", k_val=k_DEFAULT, r0_val=r0,
                      rc_val=rc, eps=epsilon_DEFAULT, sig=sigma_DEFAULT):
    """Dispatches potential energy calculation based on model."""
    if model == "ljp":
        return potential_energy_ljp(pos, eps=eps, sig=sig, rc_val=rc_val)
    return potential_energy(pos, k_val=k_val, r0_val=r0_val, rc_val=rc_val)


def mean_speed(vel):
    """Calculates mean particle speed across the system."""
    return np.mean(np.sqrt(np.sum(vel ** 2, axis=1)))


def error_func(variation_E):
    """
    Calculates maximum relative deviation from initial mechanical energy:
    max(|E(t) - E(0)|) / |E(0)|.
    """
    E0 = variation_E[0]
    if abs(E0) < 1e-12:
        return 0.0
    return np.max(np.abs(variation_E - E0)) / abs(E0)


def find_steady_state(time_arr, E_arr, window=steady_window, threshold=steady_threshold):
    """
    Identifies the earliest time at which total energy variation within a
    sliding window of length `window` falls below `threshold * |E(0)|`.
    """
    E0 = E_arr[0]
    if abs(E0) < 1e-12:
        return None
    for end in range(window, len(E_arr)):
        start = end - window
        window_energy = E_arr[start:end + 1]
        rel_var = np.max(np.abs(window_energy - window_energy[0])) / abs(E0)
        if rel_var < threshold:
            return time_arr[end]
    return None


# ==============================================================================
# 6. UNIFIED SIMULATION RUNNER
# ==============================================================================
def run_simulation(N, pos_init, vel_init, mass, dt, steps, gamma=0.0,
                   model="baseline", k_val=k_DEFAULT, r0_val=r0, rc_val=rc,
                   eps=epsilon_DEFAULT, sig=sigma_DEFAULT,
                   record_trajectory=False, integrator="verlet"):
    """
    Runs a full simulation for `steps` timesteps, recording energies, heat
    dissipation, Newton's 3rd Law internal force sum, and wall-clock runtime.
    """
    pos = pos_init.copy()
    vel = vel_init.copy()
    force = None

    time_axis = np.arange(steps + 1) * dt
    KE = np.zeros(steps + 1)
    PE = np.zeros(steps + 1)
    E_tot = np.zeros(steps + 1)
    H_cum = np.zeros(steps + 1)       # Cumulative dissipated heat integral
    dE_step = np.zeros(steps + 1)     # Stepwise energy change E[i] - E[i-1]
    speed_mean = np.zeros(steps + 1)
    F_sum = np.zeros(steps + 1)       # Sum of all internal forces (Newton's 3rd Law)

    trajectory = np.zeros((steps + 1, N, 2)) if record_trajectory else None

    # Log initial state (t = 0)
    if record_trajectory:
        trajectory[0] = pos.copy()
    KE[0] = kinetic_energy(vel, mass)
    PE[0] = compute_potential(pos, model=model, k_val=k_val, r0_val=r0_val,
                              rc_val=rc_val, eps=eps, sig=sig)
    E_tot[0] = KE[0] + PE[0]
    speed_mean[0] = mean_speed(vel)
    F_int_0 = internal_forces(pos, model=model, k_val=k_val, r0_val=r0_val,
                              rc_val=rc_val, eps=eps, sig=sig)
    F_sum[0] = np.sum(F_int_0)

    # Start timer for pure physics integration loop
    start_time = time.perf_counter()

    for step in range(1, steps + 1):
        if integrator == "euler":
            pos, vel = step_once(pos, vel, mass, dt, L, gamma=gamma, model=model,
                                 k_val=k_val, r0_val=r0_val, rc_val=rc_val,
                                 eps=eps, sig=sig)
        else:
            pos, vel, force = step_smooth(pos, vel, mass, dt, L, gamma=gamma,
                                          F_prev=force, model=model,
                                          k_val=k_val, r0_val=r0_val, rc_val=rc_val,
                                          eps=eps, sig=sig)

        if record_trajectory:
            trajectory[step] = pos.copy()

        KE[step] = kinetic_energy(vel, mass)
        PE[step] = compute_potential(pos, model=model, k_val=k_val, r0_val=r0_val,
                                     rc_val=rc_val, eps=eps, sig=sig)
        E_tot[step] = KE[step] + PE[step]
        dE_step[step] = E_tot[step] - E_tot[step - 1]
        H_cum[step] = H_cum[step - 1] + gamma * np.sum(mass[:, None] * (vel ** 2)) * dt
        speed_mean[step] = mean_speed(vel)

        # Record sum of internal forces for Newton's 3rd Law check
        F_int = internal_forces(pos, model=model, k_val=k_val, r0_val=r0_val,
                                rc_val=rc_val, eps=eps, sig=sig)
        F_sum[step] = np.sum(F_int)

    runtime = time.perf_counter() - start_time
    max_rel_err = error_func(E_tot)
    final_rel_err = abs(E_tot[-1] - E_tot[0]) / max(abs(E_tot[0]), 1e-12)

    return {
        "time": time_axis,
        "KE": KE,
        "PE": PE,
        "E": E_tot,
        "H": H_cum,
        "dE": dE_step,
        "mean_speed": speed_mean,
        "F_sum": F_sum,
        "trajectory": trajectory,
        "runtime": runtime,
        "max_rel_error": max_rel_err,
        "final_rel_error": final_rel_err,
        "dt": dt,
        "steps": steps,
    }


# ==============================================================================
# 7. MODE A: ANIMATION & ENERGY PLOT (Requirement 6)
# ==============================================================================
def run_animation_mode(N, model, gamma):
    """
    Runs the chosen simulator, shows the particle animation, plots KE, PE,
    and Total Energy, and prints maximum relative energy deviation and runtime.
    """
    dt = dt_LJP if model == "ljp" else dt_BASELINE
    vel_max = vel_max_LJP if model == "ljp" else vel_max_BASELINE
    steps = T_DEFAULT

    mass, pos_init, vel_init = initialize_particles(
        N, L, vel_max, model=model, sigma=sigma_DEFAULT, seed=SEED
    )

    model_title = "Lennard-Jones Potential (LJP)" if model == "ljp" else f"Baseline Spring (gamma={gamma})"
    print(f"\nRunning {model_title} Simulation for Animation (N={N}, dt={dt}, steps={steps})...")

    res = run_simulation(
        N, pos_init, vel_init, mass, dt=dt, steps=steps,
        gamma=gamma, model=model, record_trajectory=True
    )

    # Display required metrics in console
    print("\n" + "=" * 60)
    print(f"SIMULATION SUMMARY ({model_title})")
    print("=" * 60)
    print(f"Number of particles (N)                    : {N}")
    print(f"Timestep (dt)                              : {dt}")
    print(f"Total steps (T)                            : {steps}")
    print(f"Initial Total Energy E(0)                  : {res['E'][0]:.6f}")
    print(f"Final Total Energy E(T)                    : {res['E'][-1]:.6f}")
    print(f"Relative Maximum Deviation from Initial E  : {res['max_rel_error']:.6e}")
    print(f"Max Abs Sum of Internal Forces (3rd Law)   : {np.max(np.abs(res['F_sum'])):.6e}")
    print(f"System Time Taken to Run Simulation        : {res['runtime']:.6f} seconds")
    print("=" * 60)

    # 1. Particle Trajectory Animation
    trajectory = res["trajectory"]
    fig, ax = plt.subplots(figsize=(6, 6))
    ax.set_xlim(0, L)
    ax.set_ylim(0, L)
    ax.set_aspect("equal")
    ax.set_title(f"Atomic Toy Model Animation ({model_title}, N={N})")
    ax.set_xlabel("X Position")
    ax.set_ylabel("Y Position")
    ax.grid(True, linestyle=":", alpha=0.5)

    scatter = ax.scatter(
        trajectory[0, :, 0], trajectory[0, :, 1],
        c="royalblue", edgecolors="black", s=50, zorder=3
    )

    circles = []
    if model == "ljp":
        # Draw collision boundary circles of radius = sigma / 2 for LJP
        for i in range(N):
            circle = plt.Circle(
                (trajectory[0, i, 0], trajectory[0, i, 1]),
                radius=sigma_DEFAULT / 2.0,
                edgecolor="crimson", facecolor="none",
                linestyle="--", alpha=0.7, zorder=2
            )
            ax.add_patch(circle)
            circles.append(circle)

    # Step stride keeps animation smooth and responsive
    stride = max(1, steps // 500)
    frame_indices = range(0, steps + 1, stride)

    def update(frame_idx):
        scatter.set_offsets(trajectory[frame_idx])
        if model == "ljp":
            for i, circle in enumerate(circles):
                circle.set_center((trajectory[frame_idx, i, 0], trajectory[frame_idx, i, 1]))
            return [scatter] + circles
        return [scatter]

    anim = animation.FuncAnimation(
        fig, update, frames=frame_indices, interval=20, blit=True
    )
    plt.tight_layout()
    plt.show()

    # 2. Energy Plots (KE, PE, and Total Energy)
    plt.figure(figsize=(10, 6))
    plt.plot(res["time"], res["KE"], label="Kinetic Energy K(t)", color="tab:blue")
    plt.plot(res["time"], res["PE"], label="Potential Energy U(t)", color="tab:orange")
    plt.plot(res["time"], res["E"], label="Total Energy E_tot(t)", color="black", linestyle="--", linewidth=2)
    if gamma > 0.0:
        plt.plot(res["time"], res["H"], label="Cumulative Heat Lost H(t)", color="tab:red", linestyle=":")

    plt.xlabel("Time (t)")
    plt.ylabel("Energy")
    plt.title(
        f"System Energies vs Time ({model_title})\n"
        f"Max Rel Energy Deviation: {res['max_rel_error']:.3e} | Runtime: {res['runtime']:.4f} s"
    )
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()


