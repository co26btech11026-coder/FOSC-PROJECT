# --- Study 1: Comparison Between Various Values of Gamma (Dissipation Study) ---
def study_gamma_comparison(N, gamma_list):
    """
    Compares system dynamics across multiple viscous drag coefficients (gamma).
    Plots K(t), U(t), E(t), cumulative heat lost H(t), and Newton's 3rd Law verification,
    and prints the objective steady-state analysis.
    """
    print("\n--- Study 1: Comparison Across Gamma Values (Dissipation Analysis) ---")
    dt = dt_BASELINE
    steps = T_DEFAULT
    mass, pos_init, vel_init = initialize_particles(N, L, vel_max_BASELINE, model="baseline", seed=SEED)

    results = {}
    for g in gamma_list:
        print(f"Running simulation for gamma = {g} ...")
        results[g] = run_simulation(
            N, pos_init, vel_init, mass, dt=dt, steps=steps, gamma=g, model="baseline"
        )

    # Plot 1: K(t), U(t), and E_total(t) subplots
    fig, axes = plt.subplots(3, 1, figsize=(10, 11), sharex=True)
    for g, res in results.items():
        axes[0].plot(res["time"], res["KE"], label=f"gamma = {g}")
        axes[1].plot(res["time"], res["PE"], label=f"gamma = {g}")
        axes[2].plot(res["time"], res["E"], label=f"gamma = {g}")

    axes[0].set_ylabel("Kinetic Energy K(t)")
    axes[1].set_ylabel("Potential Energy U(t)")
    axes[2].set_ylabel("Total Energy E(t)")
    axes[2].set_xlabel("Time")
    axes[0].set_title(f"Dissipation Study: Energies vs Time (N={N})")
    for ax in axes:
        ax.grid(True)
        ax.legend()
    plt.tight_layout()
    plt.show()

    # Plot 2: Cumulative Heat Lost H(t) & Newton's 3rd Law Check
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))
    for g, res in results.items():
        ax1.plot(res["time"], res["H"], label=f"gamma = {g}")
        ax2.plot(res["time"], res["F_sum"], label=f"gamma = {g}")

    ax1.set_xlabel("Time")
    ax1.set_ylabel("Cumulative Dissipated Energy H(t)")
    ax1.set_title("Cumulative Heat Dissipation vs Time")
    ax1.grid(True)
    ax1.legend()

    ax2.set_xlabel("Time")
    ax2.set_ylabel("Sum of Internal Pair Forces")
    ax2.set_title("Verification of Newton's 3rd Law (Sum F_int = 0)")
    ax2.grid(True)
    ax2.legend()
    plt.tight_layout()
    plt.show()

    # Steady-state summary output
    print("\nSteady-State Analysis Summary")
    print("-" * 55)
    for g, res in results.items():
        steady_t = find_steady_state(res["time"], res["E"])
        if steady_t is None:
            print(f"gamma = {g:<6}: steady-state criterion NOT reached within t = {steps * dt:.2f}")
        else:
            print(f"gamma = {g:<6}: steady-state criterion first satisfied at t = {steady_t:.2f}")
        print(f"    Initial Energy   = {res['E'][0]:.6f}")
        print(f"    Final Energy     = {res['E'][-1]:.6f}")
        print(f"    Final Mean Speed = {res['mean_speed'][-1]:.6e}")
        print(f"    Final Heat Lost  = {res['H'][-1]:.6f}")
        print(f"    Runtime          = {res['runtime']:.6f} s\n")


# --- Study 2: Baseline vs LJP Across Several Runs ---
def study_baseline_vs_ljp_runs(N, num_runs=5):
    """
    Compares Maximum Relative Energy Deviation, Execution Runtime, Energy Fluctuations,
    and Newton's 3rd Law force balance between Baseline and LJP across multiple
    independent runs (different initial seeds).
    """
    print(f"\n--- Study 2: Baseline vs LJP Comparison Across {num_runs} Independent Runs ---")
    steps = T_DEFAULT

    base_errors, ljp_errors = [], []
    base_times, ljp_times = [], []
    base_fsum_max, ljp_fsum_max = [], []

    sample_base_res = None
    sample_ljp_res = None

    for run_idx in range(num_runs):
        run_seed = SEED + run_idx * 101

        # Baseline run
        m_b, p_b, v_b = initialize_particles(N, L, vel_max_BASELINE, model="baseline", seed=run_seed)
        res_b = run_simulation(N, p_b, v_b, m_b, dt=dt_BASELINE, steps=steps, gamma=0.0, model="baseline")
        base_errors.append(res_b["max_rel_error"])
        base_times.append(res_b["runtime"])
        base_fsum_max.append(np.max(np.abs(res_b["F_sum"])))

        # LJP run (using stable LJP parameters)
        m_l, p_l, v_l = initialize_particles(N, L, vel_max_LJP, model="ljp", sigma=sigma_DEFAULT, seed=run_seed)
        res_l = run_simulation(N, p_l, v_l, m_l, dt=dt_LJP, steps=steps, gamma=0.0, model="ljp")
        ljp_errors.append(res_l["max_rel_error"])
        ljp_times.append(res_l["runtime"])
        ljp_fsum_max.append(np.max(np.abs(res_l["F_sum"])))

        if run_idx == 0:
            sample_base_res = res_b
            sample_ljp_res = res_l

        print(
            f"Run {run_idx + 1}: "
            f"Baseline [MaxRelErr={res_b['max_rel_error']:.3e}, Time={res_b['runtime']:.4f}s] | "
            f"LJP [MaxRelErr={res_l['max_rel_error']:.3e}, Time={res_l['runtime']:.4f}s]"
        )

    runs_x = np.arange(1, num_runs + 1)
    width = 0.35

    # Figure 1: Bar Charts for Max Relative Energy Difference & Runtime across Runs
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))

    ax1.bar(runs_x - width / 2, base_errors, width, label="Baseline (Spring)", color="steelblue")
    ax1.bar(runs_x + width / 2, ljp_errors, width, label="LJP Simulator", color="darkorange")
    ax1.set_yscale("log")
    ax1.set_xticks(runs_x)
    ax1.set_xticklabels([f"Run {i}" for i in runs_x])
    ax1.set_ylabel("Max Relative Energy Deviation (log scale)")
    ax1.set_title("Max Relative Energy Difference: Baseline vs LJP")
    ax1.legend()
    ax1.grid(True, which="both", linestyle="--", alpha=0.5)

    ax2.bar(runs_x - width / 2, base_times, width, label="Baseline (Spring)", color="steelblue")
    ax2.bar(runs_x + width / 2, ljp_times, width, label="LJP Simulator", color="darkorange")
    ax2.set_xticks(runs_x)
    ax2.set_xticklabels([f"Run {i}" for i in runs_x])
    ax2.set_ylabel("Execution Time (seconds)")
    ax2.set_title("Simulation Runtime: Baseline vs LJP")
    ax2.legend()
    ax2.grid(True, linestyle="--", alpha=0.5)

    plt.tight_layout()
    plt.show()

    # Figure 2: Relative Energy Fluctuation & Newton's 3rd Law Verification (Sample Run 1)
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))

    norm_steps = np.arange(steps + 1)
    rel_E_base = (sample_base_res["E"] - sample_base_res["E"][0]) / abs(sample_base_res["E"][0])
    rel_E_ljp = (sample_ljp_res["E"] - sample_ljp_res["E"][0]) / abs(sample_ljp_res["E"][0])

    ax1.plot(norm_steps, rel_E_base, label="Baseline Relative dE/E(0)", color="steelblue")
    ax1.plot(norm_steps, rel_E_ljp, label="LJP Relative dE/E(0)", color="darkorange", alpha=0.85)
    ax1.set_xlabel("Timestep Index")
    ax1.set_ylabel("(E(t) - E(0)) / |E(0)|")
    ax1.set_title("Relative Energy Fluctuation Over Timesteps (Run 1)")
    ax1.legend()
    ax1.grid(True)

    ax2.plot(norm_steps, sample_base_res["F_sum"], label="Baseline Sum(F_int)", color="steelblue")
    ax2.plot(norm_steps, sample_ljp_res["F_sum"], label="LJP Sum(F_int)", color="darkorange", alpha=0.85)
    ax2.set_xlabel("Timestep Index")
    ax2.set_ylabel("Sum of All Internal Forces")
    ax2.set_title("Newton's 3rd Law Verification (Sum of Forces = 0)")
    ax2.legend()
    ax2.grid(True)

    plt.tight_layout()
    plt.show()


# --- Study 3: Comparison Between Various Timesteps (dt) ---
def study_timestep_comparison(N, model="baseline"):
    """
    Studies how total energy fluctuates and how numerical error and runtime scale
    across timesteps dt = [0.01, 0.02, 0.05, 0.1, 0.2, 0.5] (plus finer steps for LJP).
    """
    print(f"\n--- Study 3: Timestep (dt) Sensitivity Analysis ({model.upper()}) ---")
    # Include the exact prompt-requested timesteps; prepend finer steps if LJP is selected
    dt_values = [0.01, 0.02, 0.05, 0.1, 0.2, 0.5]
    if model == "ljp":
        dt_values = [0.0005, 0.001, 0.002, 0.005, 0.01, 0.02, 0.05]
        print("Note: For LJP, added fine timesteps [0.0005 .. 0.005] alongside larger dt to show stability boundary.")

    total_time = 10.0 if model == "baseline" else 2.0
    vel_max = vel_max_LJP if model == "ljp" else vel_max_BASELINE
    mass, pos_init, vel_init = initialize_particles(N, L, vel_max, model=model, seed=SEED)

    results = []
    for dt_val in dt_values:
        steps = max(10, int(round(total_time / dt_val)))
        res = run_simulation(N, pos_init, vel_init, mass, dt=dt_val, steps=steps, gamma=0.0, model=model)
        results.append(res)
        print(
            f"dt = {dt_val:<7} | steps = {steps:<5} | "
            f"Max Rel Energy Error = {res['max_rel_error']:.4e} | "
            f"Runtime = {res['runtime']:.5f} s"
        )

    # Plot 1: Total Energy E(t) Trajectories & Relative Energy Error
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5.5))
    for res in results:
        dt_val = res["dt"]
        ax1.plot(res["time"], res["E"], label=f"dt = {dt_val}")
        rel_dev = np.abs(res["E"] - res["E"][0]) / max(abs(res["E"][0]), 1e-12)
        ax2.plot(res["time"], rel_dev + 1e-16, label=f"dt = {dt_val}")

    ax1.set_xlabel("Time (t)")
    ax1.set_ylabel("Total Energy E(t)")
    ax1.set_title(f"Total Energy Fluctuations Across Timesteps ({model.upper()})")
    ax1.legend()
    ax1.grid(True)

    ax2.set_yscale("log")
    ax2.set_xlabel("Time (t)")
    ax2.set_ylabel("Relative Energy Deviation |E(t) - E(0)| / |E(0)|")
    ax2.set_title("Log-Scale Relative Energy Fluctuation vs Time")
    ax2.legend()
    ax2.grid(True, which="both", linestyle="--", alpha=0.5)
    plt.tight_layout()
    plt.show()

    # Plot 2: Max Relative Energy Error vs dt, Runtime vs dt, and Newton's 3rd Law
    fig, axes = plt.subplots(1, 3, figsize=(16, 4.8))
    dts = [r["dt"] for r in results]
    max_errs = [r["max_rel_error"] for r in results]
    runtimes = [r["runtime"] for r in results]

    axes[0].loglog(dts, max_errs, marker="o", linewidth=2, color="crimson")
    axes[0].set_xlabel("Timestep dt (log scale)")
    axes[0].set_ylabel("Max Relative Energy Error (log scale)")
    axes[0].set_title("Accuracy Trade-off: Max Energy Error vs dt")
    axes[0].grid(True, which="both", linestyle="--", alpha=0.5)

    axes[1].loglog(dts, runtimes, marker="s", linewidth=2, color="teal")
    axes[1].set_xlabel("Timestep dt (log scale)")
    axes[1].set_ylabel("Runtime in seconds (log scale)")
    axes[1].set_title("Computational Cost: Runtime vs dt")
    axes[1].grid(True, which="both", linestyle="--", alpha=0.5)

    for res in results:
        axes[2].plot(res["time"], res["F_sum"], label=f"dt = {res['dt']}")
    axes[2].set_xlabel("Time (t)")
    axes[2].set_ylabel("Sum of All Internal Forces")
    axes[2].set_title("Newton's 3rd Law Verification Across dt")
    axes[2].legend(fontsize=8)
    axes[2].grid(True)

    plt.tight_layout()
    plt.show()


# --- Study 4: How Energies Change With Spring Constant (k) ---
def study_spring_constant_comparison(N):
    """
    Evaluates how Kinetic Energy K(t), Potential Energy U(t), Total Energy E(t),
    and Relative Energy Error behave as the spring stiffness k varies.
    """
    print("\n--- Study 4: Sensitivity to Spring Constant (k) ---")
    k_values = [0.2, 0.5, 1.0, 2.5, 5.0, 10.0]
    dt = dt_BASELINE
    steps = T_DEFAULT
    mass, pos_init, vel_init = initialize_particles(N, L, vel_max_BASELINE, model="baseline", seed=SEED)

    results = {}
    for k_val in k_values:
        res = run_simulation(
            N, pos_init, vel_init, mass, dt=dt, steps=steps,
            gamma=0.0, model="baseline", k_val=k_val
        )
        results[k_val] = res
        print(
            f"k = {k_val:<5} | E(0) = {res['E'][0]:<10.4f} | "
            f"Mean U(t) = {np.mean(res['PE']):<10.4f} | "
            f"Max Rel Energy Error = {res['max_rel_error']:.4e}"
        )

    # Plot 1: K(t), U(t), and E(t) for each k value
    fig, axes = plt.subplots(3, 1, figsize=(10, 11), sharex=True)
    for k_val, res in results.items():
        axes[0].plot(res["time"], res["KE"], label=f"k = {k_val}")
        axes[1].plot(res["time"], res["PE"], label=f"k = {k_val}")
        axes[2].plot(res["time"], res["E"], label=f"k = {k_val}")

    axes[0].set_ylabel("Kinetic Energy K(t)")
    axes[1].set_ylabel("Potential Energy U(t)")
    axes[2].set_ylabel("Total Energy E(t)")
    axes[2].set_xlabel("Time (t)")
    axes[0].set_title(f"Effect of Spring Constant (k) on System Energies (N={N}, dt={dt})")
    for ax in axes:
        ax.grid(True)
        ax.legend(loc="upper right", ncol=2)
    plt.tight_layout()
    plt.show()

    # Plot 2: Max Relative Error vs k and Newton's 3rd Law check
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))
    k_list = list(results.keys())
    err_list = [results[k_v]["max_rel_error"] for k_v in k_list]

    ax1.plot(k_list, err_list, marker="o", linewidth=2, color="purple")
    ax1.set_xlabel("Spring Constant (k)")
    ax1.set_ylabel("Max Relative Energy Error")
    ax1.set_title("Energy Conservation Error vs Spring Stiffness (k)")
    ax1.grid(True)

    for k_val, res in results.items():
        ax2.plot(res["time"], res["F_sum"], label=f"k = {k_val}")
    ax2.set_xlabel("Time (t)")
    ax2.set_ylabel("Sum of All Internal Forces")
    ax2.set_title("Newton's 3rd Law Verification Across k")
    ax2.legend()
    ax2.grid(True)

    plt.tight_layout()
    plt.show()


# --- Study 5: Additional Study - Integrator Comparison (Euler vs Velocity Verlet) & LJP Parameter Study ---
def study_integrator_and_ljp_stability(N):
    """
    Additional Study (Requirement 7.5):
    Part A: Compares 1st-order Euler (step_once) vs 2nd-order Velocity Verlet (step_smooth).
    Part B: Compares LJP stability across different (epsilon, sigma) combinations.
    """
    print("\n--- Study 5: Integrator Comparison (Euler vs Velocity Verlet) & LJP Parameter Study ---")
    steps = 1000
    mass, pos_init, vel_init = initialize_particles(N, L, vel_max_BASELINE, model="baseline", seed=SEED)

    res_verlet = run_simulation(
        N, pos_init, vel_init, mass, dt=dt_BASELINE, steps=steps,
        gamma=0.0, model="baseline", integrator="verlet"
    )
    res_euler = run_simulation(
        N, pos_init, vel_init, mass, dt=dt_BASELINE, steps=steps,
        gamma=0.0, model="baseline", integrator="euler"
    )

    print(f"Velocity Verlet Max Rel Energy Error : {res_verlet['max_rel_error']:.4e}")
    print(f"Euler-Cromer    Max Rel Energy Error : {res_euler['max_rel_error']:.4e}")

    # Plot Part A: Integrator comparison + Newton's 3rd Law
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))
    ax1.plot(res_verlet["time"], res_verlet["E"], label="Velocity Verlet (step_smooth)", linewidth=2)
    ax1.plot(res_euler["time"], res_euler["E"], label="Euler (step_once)", linestyle="--")
    ax1.set_xlabel("Time (t)")
    ax1.set_ylabel("Total Energy E(t)")
    ax1.set_title("Integrator Comparison: Velocity Verlet vs Euler")
    ax1.legend()
    ax1.grid(True)

    ax2.plot(res_verlet["time"], res_verlet["F_sum"], label="Velocity Verlet Sum(F_int)")
    ax2.plot(res_euler["time"], res_euler["F_sum"], label="Euler Sum(F_int)", alpha=0.7)
    ax2.set_xlabel("Time (t)")
    ax2.set_ylabel("Sum of All Internal Forces")
    ax2.set_title("Newton's 3rd Law Verification (Internal Force Sum = 0)")
    ax2.legend()
    ax2.grid(True)
    plt.tight_layout()
    plt.show()

    # Part B: LJP Parameter Sensitivity (varying epsilon)
    eps_values = [0.5, 1.0, 2.0, 5.0]
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))
    mass_l, pos_l, vel_l = initialize_particles(N, L, vel_max_LJP, model="ljp", sigma=sigma_DEFAULT, seed=SEED)

    for eps_val in eps_values:
        res_l = run_simulation(
            N, pos_l, vel_l, mass_l, dt=dt_LJP, steps=steps,
            gamma=0.0, model="ljp", eps=eps_val, sig=sigma_DEFAULT
        )
        rel_err_t = (res_l["E"] - res_l["E"][0]) / abs(res_l["E"][0])
        ax1.plot(res_l["time"], res_l["E"], label=f"epsilon = {eps_val}")
        ax2.plot(res_l["time"], rel_err_t, label=f"epsilon = {eps_val} (MaxErr={res_l['max_rel_error']:.2e})")
        print(f"LJP epsilon = {eps_val:<4} | Max Rel Energy Error = {res_l['max_rel_error']:.4e}")

    ax1.set_xlabel("Time (t)")
    ax1.set_ylabel("Total Energy E(t)")
    ax1.set_title(f"LJP Total Energy for Various Well Depths epsilon (sigma={sigma_DEFAULT})")
    ax1.legend()
    ax1.grid(True)

    ax2.set_xlabel("Time (t)")
    ax2.set_ylabel("Relative Energy Deviation (E(t) - E(0)) / |E(0)|")
    ax2.set_title("LJP Relative Energy Fluctuation vs epsilon")
    ax2.legend()
    ax2.grid(True)
    plt.tight_layout()
    plt.show()


