# 9. INTERACTIVE COMMAND-LINE MENU (Requirements 1 - 7)
# ==============================================================================
def main():
    print("=" * 70)
    print("   UNIFIED PARTICLE DYNAMICS SIMULATOR (BASELINE SPRING & LJP)")
    print("=" * 70)

    # 1. Prompt user for N
    n_input = input("1. Enter the number of particles N [default = 25]: ").strip()
    try:
        N = int(n_input) if n_input else 25
        if N < 2:
            print("   N must be at least 2. Setting N = 25.")
            N = 25
    except ValueError:
        print("   Invalid input. Setting N = 25.")
        N = 25

    # 3. Allow user to choose between Baseline simulator or LJP simulator
    print("\n2. Choose the Simulator Model:")
    print("   [1] Baseline Harmonic Spring Simulator")
    print("   [2] Lennard-Jones Potential (LJP) Simulator")
    model_choice = input("   Enter choice (1 or 2) [default = 1]: ").strip()
    model = "ljp" if model_choice == "2" else "baseline"

    # 4. For baseline simulator, allow user to choose/type gamma values
    gamma_single = 0.0
    gamma_list = [0.0, 0.05, 0.1, 0.5]
    if model == "baseline":
        g_in = input(
            "\n3. Enter viscous drag gamma for single/animation run (e.g. 0.0, 0.05, 0.1)\n"
            "   or comma-separated list for gamma study [default = 0.0]: "
        ).strip()
        if g_in:
            try:
                parsed = [float(x.strip()) for x in g_in.split(",") if x.strip() != ""]
                if len(parsed) == 1:
                    gamma_single = parsed[0]
                    if gamma_single not in gamma_list:
                        gamma_list = sorted(list(set(gamma_list + [gamma_single])))
                elif len(parsed) > 1:
                    gamma_list = parsed
                    gamma_single = parsed[0]
            except ValueError:
                print("   Invalid gamma input. Using default gamma = 0.0.")

    # 5. Allow user to choose between Animation or Graphical/Comparative Studies
    print("\n4. Choose Execution Mode:")
    print("   [1] Animation Mode (Particle Animation + KE/PE/Total Energy Plot + Error & Runtime)")
    print("   [2] Graphical & Comparative Analysis Studies")
    mode_choice = input("   Enter choice (1 or 2) [default = 1]: ").strip()

    if mode_choice != "2":
        # 6. Animation Mode (no comparative analysis, only animation + energy plot + metrics)
        run_animation_mode(N, model=model, gamma=gamma_single)
    else:
        # 7. Graphical & Comparative Studies Menu
        while True:
            print("\n" + "=" * 70)
            print("   GRAPHICAL & COMPARATIVE ANALYSIS MENU")
            print("=" * 70)
            print("   [1] Comparison between various values of gamma (Dissipation Study)")
            print("   [2] Comparison of Max Relative Energy Difference & Runtime: Baseline vs LJP (Multiple Runs)")
            print("   [3] Comparison between various timesteps (dt = 0.01, 0.02, 0.05, 0.1, 0.2, 0.5)")
            print("   [4] How energies change with Spring Constant (k)")
            print("   [5] Integrator Comparison (Euler vs Velocity Verlet) & LJP Parameter Sensitivity")
            print("   [6] Run ALL Comparative Studies")
            print("   [0] Exit")

            study_choice = input("\n   Select analysis to view (0-6): ").strip()

            if study_choice == "1":
                custom_g = input(
                    f"   Enter comma-separated gamma values [Press Enter for {gamma_list}]: "
                ).strip()
                if custom_g:
                    try:
                        gamma_list = [float(x.strip()) for x in custom_g.split(",") if x.strip() != ""]
                    except ValueError:
                        print("   Invalid list; using previous gamma list.")
                study_gamma_comparison(N, gamma_list)

            elif study_choice == "2":
                runs_in = input("   Enter number of independent runs to compare [default = 5]: ").strip()
                num_runs = int(runs_in) if runs_in.isdigit() and int(runs_in) > 0 else 5
                study_baseline_vs_ljp_runs(N, num_runs=num_runs)

            elif study_choice == "3":
                study_timestep_comparison(N, model=model)

            elif study_choice == "4":
                study_spring_constant_comparison(N)

            elif study_choice == "5":
                study_integrator_and_ljp_stability(N)

            elif study_choice == "6":
                study_gamma_comparison(N, gamma_list)
                study_baseline_vs_ljp_runs(N, num_runs=5)
                study_timestep_comparison(N, model=model)
                study_spring_constant_comparison(N)
                study_integrator_and_ljp_stability(N)

            elif study_choice == "0":
                print("Exiting simulator.")
                break
            else:
                print("   Invalid choice. Please enter a number from 0 to 6.")


if __name__ == "__main__":
    main()
